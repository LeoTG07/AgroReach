# Copy this file to .env and fill in your own values.
# .env is never committed/shared — it's where your real secrets live.

# ---- Server ----
PORT=3000
SESSION_SECRET=change-this-to-any-random-long-string

# ---- Paystack (Test Mode) ----
# From dashboard.paystack.com > Settings > API Keys & Webhooks
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- First Admin account bootstrap (used once by "npm run create-admin") ----
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@agroreach.local
ADMIN_PASSWORD=change-this-password
